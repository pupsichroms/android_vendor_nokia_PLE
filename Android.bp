// Exact PLE619F ARM32 audio; extract-audio.py pins inputs and preserves code.
soong_namespace {}

cc_defaults {
    name: "ple_stock_audio_defaults",
    proprietary: true,
    compile_multilib: "32",
    strip: {
        none: true,
    },
    shared_libs: [
        "libcutils",
        "libutils",
        "liblog",
        "libc++",
    ],
}

cc_prebuilt_library_shared {
    name: "audio.primary.ple",
    defaults: ["ple_stock_audio_defaults"],
    relative_install_path: "hw",
    srcs: ["proprietary/vendor/lib/hw/audio.primary.ple.so"],
    overrides: [
        "audio.primary.default",
        "audio.primary.msm8937",
    ],
    shared_libs: [
        "libtinyalsa",
        "libtinycompress_vendor",
        "libaudioroute",
        "libaudioutils",
        "libexpat",
        "lib_FIH_SmartAmp",
        "libaudio_log_utils",
        "libprocessgroup",
    ],
}

cc_prebuilt_library_shared {
    name: "lib_FIH_SmartAmp",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/lib_FIH_SmartAmp.so"],
}

cc_prebuilt_library_shared {
    name: "libtinycompress_vendor",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/libtinycompress_vendor.so"],
}

cc_prebuilt_library_shared {
    name: "libaudio_log_utils",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/libaudio_log_utils.so"],
    shared_libs: ["libexpat"],
}

cc_prebuilt_library_shared {
    name: "libacdbloader",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/libacdbloader.so"],
    shared_libs: [
        "libaudcal",
        "libtinyalsa",
        "libacdbrtac",
        "libadiertac",
        "libacdb-fts",
    ],
}

cc_prebuilt_library_shared {
    name: "libaudcal",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/libaudcal.so"],
    shared_libs: ["libdiag.pleaudio"],
}

cc_prebuilt_library_shared {
    name: "libacdbrtac",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/libacdbrtac.so"],
    shared_libs: ["libaudcal"],
}

cc_prebuilt_library_shared {
    name: "libadiertac",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/libadiertac.so"],
    shared_libs: ["libaudcal"],
}

cc_prebuilt_library_shared {
    name: "libacdb-fts",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/libacdb-fts.so"],
    shared_libs: ["libaudcal"],
}

cc_prebuilt_library_shared {
    name: "libdiag.pleaudio",
    stem: "libdiag",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/libdiag.so"],
}

cc_prebuilt_library_shared {
    name: "libadm",
    defaults: ["ple_stock_audio_defaults"],
    srcs: ["proprietary/vendor/lib/libadm.so"],
    shared_libs: ["libtinyalsa"],
}
